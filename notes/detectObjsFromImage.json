{
  "openapi": "3.0.3",
  "info": {
    "title": "Image Detection API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://adc6a403b34a546beb89eace1672998a-693756402.us-east-1.elb.amazonaws.com:8000"
    }
  ],
  "paths": {
    "/v1/recognition/image_debug": {
      "post": {
        "operationId": "detectObjsFromImage",
        "summary": "识别图像中包含的目标",
        "description": "从图像中识别所有支持的目标。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "verify_gun",
                  "event_id",
                  "image_key",
                  "image_base64",
                  "labels",
                  "ori_model",
                  "gun_error_policy"
                ],
                "properties": {
                  "verify_gun": {
                    "type": "boolean",
                    "enum": [true],
                    "description": "是否针对枪支进行复检，固定传 true"
                  },
                  "event_id": {
                    "type": "string",
                    "description": "事件 ID，默认使用当前时间戳"
                  },
                  "image_key": {
                    "type": "string",
                    "description": "图片 Key，默认使用当前时间戳"
                  },
                  "image_base64": {
                    "type": "string",
                    "format": "byte",
                    "description": "图片的 Base64 编码"
                  },
                  "labels": {
                    "type": "array",
                    "description": "检测目标英文名列表",
                    "items": {
                      "type": "string",
                      "enum": ["gun", "bear", "person"]
                    }
                  },
                  "ori_model": {
                    "type": "string",
                    "enum": ["ai_bench_test"],
                    "description": "固定传 ai_bench_test"
                  },
                  "gun_error_policy": {
                    "type": "string",
                    "enum": ["remove"],
                    "description": "固定传 remove"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "从图片中识别到的目标",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  }
}
